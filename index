const EMAIL_DESTINO = "cjbc6daw@gmail.com";

let searchTerm = "";
const state = {}; // key: producto -> {checked, nota}

function keyOf(p){ return p.producto.toLowerCase(); }
function normaliza(s){
  return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}
CATALOGO.forEach(p => state[keyOf(p)] = {checked:false, nota:""});

function renderList(){
  const el = document.getElementById('productContainer');
  const items = CATALOGO
    .filter(p => !searchTerm || normaliza(p.producto).includes(searchTerm))
    .sort((a,b)=>a.producto.localeCompare(b.producto,'es'));

  if(items.length===0){
    el.innerHTML = `<div class="empty-msg">No encontré productos con ese nombre.</div>`;
    return;
  }

  let html = `<div class="product-list">`;
  items.forEach(p=>{
    const k = keyOf(p);
    const st = state[k];
    html += `<div class="item ${st.checked?'checked':''}" data-key="${k}">
      <input type="checkbox" id="chk-${k}" ${st.checked?'checked':''}>
      <label for="chk-${k}">${p.producto}<span class="prov-tag">🛒 ${p.proveedor}</span>${p.categoria?`<span class="cat-tag">${p.categoria}</span>`:""}</label>
      <input type="text" class="note" placeholder="cant./nota" value="${st.nota}">
    </div>`;
  });
  html += `</div>`;
  el.innerHTML = html;

  el.querySelectorAll('.item input[type=checkbox]').forEach(cb=>{
    cb.addEventListener('change', e=>{
      const key = e.target.closest('.item').dataset.key;
      state[key].checked = e.target.checked;
      e.target.closest('.item').classList.toggle('checked', e.target.checked);
      updateCount();
    });
  });
  el.querySelectorAll('.item .note').forEach(inp=>{
    inp.addEventListener('input', e=>{
      const key = e.target.closest('.item').dataset.key;
      state[key].nota = e.target.value;
    });
  });
}

function updateCount(){
  const n = Object.values(state).filter(s=>s.checked).length;
  document.getElementById('selCount').textContent = n;
  document.getElementById('verPedidoBtn').disabled = n===0;
}

function buildOrderBySupplier(){
  const bySup = {};
  CATALOGO.forEach(p=>{
    const st = state[keyOf(p)];
    if(!st.checked) return;
    if(!bySup[p.proveedor]) bySup[p.proveedor] = [];
    bySup[p.proveedor].push(p.producto + (st.nota ? ` (${st.nota})` : ""));
  });
  return bySup;
}

function fechaHoy(){
  const d = new Date();
  return d.toLocaleDateString('es-MX', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
}

function renderModal(){
  const bySup = buildOrderBySupplier();
  const provsOrdered = Object.keys(bySup).sort((a,b)=>a.localeCompare(b,'es'));
  document.getElementById('modalDate').textContent = fechaHoy();
  let html = "";
  provsOrdered.forEach(prov=>{
    html += `<div class="sup-block"><h4>🛒 ${prov}</h4><ul>`;
    bySup[prov].forEach(name=> html += `<li>${name}</li>`);
    html += `</ul></div>`;
  });
  document.getElementById('modalContent').innerHTML = html || `<p>No hay productos seleccionados.</p>`;

  let printHtml = `<h2>Pedido Sixto Café</h2><div>${fechaHoy()}</div>`;
  provsOrdered.forEach(prov=>{
    printHtml += `<h4>${prov}</h4><ul>`;
    bySup[prov].forEach(name=> printHtml += `<li>${name}</li>`);
    printHtml += `</ul>`;
  });
  document.getElementById('printArea').innerHTML = printHtml;
}

function textoPlano(){
  const bySup = buildOrderBySupplier();
  const provsOrdered = Object.keys(bySup).sort((a,b)=>a.localeCompare(b,'es'));
  let txt = `Pedido Sixto Café — ${fechaHoy()}\n`;
  provsOrdered.forEach(prov=>{
    txt += `\n${prov}\n`;
    bySup[prov].forEach(name=> txt += `- ${name}\n`);
  });
  return txt.trim();
}

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2200);
}

document.getElementById('searchInput').addEventListener('input', e=>{
  searchTerm = e.target.value.trim().toLowerCase();
  renderList();
});

document.getElementById('verPedidoBtn').addEventListener('click', ()=>{
  renderModal();
  document.getElementById('modalOverlay').classList.add('open');
});
document.getElementById('closeModal').addEventListener('click', ()=>{
  document.getElementById('modalOverlay').classList.remove('open');
});
document.getElementById('modalOverlay').addEventListener('click', e=>{
  if(e.target.id === 'modalOverlay') document.getElementById('modalOverlay').classList.remove('open');
});

document.getElementById('sendBtn').addEventListener('click', ()=>{
  const txt = textoPlano();
  const subject = encodeURIComponent(`Pedido Sixto Café — ${fechaHoy()}`);
  const body = encodeURIComponent(txt);
  window.location.href = `mailto:${EMAIL_DESTINO}?subject=${subject}&body=${body}`;
  showToast('Abriendo tu correo con el pedido listo para enviar...');
});

document.getElementById('printBtn').addEventListener('click', ()=>{
  window.print();
});

document.getElementById('clearBtn').addEventListener('click', ()=>{
  Object.keys(state).forEach(k=>{ state[k].checked=false; state[k].nota=""; });
  renderList(); updateCount();
  document.getElementById('modalOverlay').classList.remove('open');
  showToast('Selección limpiada');
});

