<div class="toolbar">
  <div class="search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" id="searchInput" placeholder="Buscar producto...">
  </div>
</div>

<main>
  <div id="productContainer"></div>
</main>

<div class="bottombar">
  <div class="count"><b id="selCount">0</b> artículos seleccionados</div>
  <button id="verPedidoBtn" disabled>Ver pedido</button>
</div>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <div class="modal-wrap">
      <button class="btn-close" id="closeModal">✕</button>
      <h2>📋 Pedido Sixto Café</h2>
      <div class="sub" id="modalDate"></div>
      <div id="modalContent"></div>
      <div class="modal-actions">
        <button class="btn-send" id="sendBtn">Enviar pedido</button>
        <button class="btn-print" id="printBtn">Imprimir</button>
        <button class="btn-clear" id="clearBtn">Limpiar selección</button>
