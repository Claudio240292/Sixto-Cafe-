<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Sixto Café · Pedido de compras</title>
<style>
  :root{
    --cream:#FBF6EE;
    --cream-2:#F3E7DE;
    --ink:#2A1416;
    --ink-soft:#7A5C5E;
    --red:#B5262B;
    --red-dark:#7C1E22;
    --red-light:#D9534F;
    --line:#EAD9D6;
    --white:#FFFFFF;
    --shadow: 0 4px 16px rgba(42,20,22,0.14);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family: "Georgia", "Times New Roman", serif;
    padding-bottom:96px;
    -webkit-font-smoothing:antialiased;
  }
  header{
    background:linear-gradient(135deg, var(--red-dark), var(--red));
    color:#fff;
    padding:22px 18px 20px;
    position:sticky; top:0; z-index:20;
    box-shadow:var(--shadow);
  }
  header h1{margin:0; font-size:1.35rem; letter-spacing:.2px; font-family:"Verdana", "Geneva", sans-serif; font-weight:bold;}
  header p{margin:4px 0 0; font-size:.85rem; opacity:.9;}

  .toolbar{
    background:var(--cream);
    position:sticky; top:70px; z-index:19;
    padding:12px 14px 10px;
    border-bottom:1px solid var(--line);
  }
  header + .toolbar{top:74px;}

  .search{
    display:flex; align-items:center; gap:8px;
    background:var(--white);
    border:1px solid var(--line);
    border-radius:10px;
    padding:9px 12px;
  }
  .search input{
    border:none; outline:none; flex:1;
    font-size:.95rem; background:transparent; color:var(--ink);
  }
  .search svg{flex-shrink:0; opacity:.55; color:var(--ink-soft);}

  main{padding:14px;}

  .product-list{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
  }

  .item{
    display:flex; align-items:center; gap:10px;
    padding:11px 12px;
    border-bottom:1px solid var(--line);
  }
  .item:last-child{border-bottom:none;}
  .item input[type=checkbox]{
    width:20px; height:20px; accent-color:var(--red); flex-shrink:0; cursor:pointer;
  }
  .item label{flex:1; font-size:.92rem; cursor:pointer; line-height:1.5;}
  .item .prov-tag{
    display:inline-block;
    font-size:.7rem; font-weight:600; color:var(--red-dark); background:var(--cream-2);
    border-radius:6px; padding:2px 7px; margin-left:6px; vertical-align:middle;
  }
  .item .cat-tag{
    font-size:.68rem; color:var(--ink-soft); background:var(--cream);
    border:1px solid var(--line);
    border-radius:6px; padding:1px 6px; margin-left:4px; vertical-align:middle;
  }
  .item .note{
    width:0; opacity:0; border:1px solid var(--line); border-radius:8px;
    padding:0 8px; font-size:.8rem; transition:.15s; height:32px;
  }
  .item.checked{background:#FBEDEA;}
  .item.checked .note{width:110px; opacity:1; padding:0 8px;}

  .empty-msg{padding:20px; text-align:center; color:var(--ink-soft); font-size:.9rem;}

  .bottombar{
    position:fixed; bottom:0; left:0; right:0; z-index:30;
    background:var(--red-dark); color:#fff;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 16px; box-shadow:0 -4px 16px rgba(0,0,0,.18);
  }
  .bottombar .count{font-size:.9rem;}
  .bottombar .count b{font-size:1.1rem;}
  .bottombar button{
    background:var(--red); color:#fff; border:none;
    padding:11px 20px; border-radius:10px; font-weight:700; font-size:.92rem;
    cursor:pointer;
  }
  .bottombar button:disabled{opacity:.4;}

  .modal-overlay{
    position:fixed; inset:0; background:rgba(42,20,22,.55); z-index:40;
    display:none; align-items:flex-end; justify-content:center;
  }
  .modal-overlay.open{display:flex;}
  .modal{
    background:var(--cream); width:100%; max-width:560px;
    border-radius:18px 18px 0 0; max-height:85vh; overflow-y:auto;
    padding:18px 18px 22px;
  }
  .modal h2{margin:0 0 4px; font-size:1.1rem; color:var(--red-dark);}
  .modal .sub{font-size:.78rem; color:var(--ink-soft); margin-bottom:14px;}
  .modal .sup-block{margin-bottom:14px;}
  .modal .sup-block h4{
    margin:0 0 6px; font-size:.85rem; color:var(--red-dark);
    border-bottom:1px solid var(--line); padding-bottom:4px;
  }
  .modal .sup-block ul{margin:0; padding-left:18px; font-size:.88rem;}
  .modal .sup-block li{margin-bottom:3px;}
  .modal-actions{display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;}
  .modal-actions button{
    flex:1; min-width:120px; padding:11px; border-radius:10px; border:none;
    font-weight:600; font-size:.88rem; cursor:pointer;
  }
  .btn-send{background:var(--red); color:#fff;}
  .btn-print{background:var(--white); color:var(--ink); border:1px solid var(--line) !important;}
  .btn-clear{background:transparent; color:var(--ink-soft); border:1px solid var(--line) !important;}
  .btn-close{
    position:absolute; top:14px; right:16px; background:none; border:none;
    font-size:1.3rem; color:var(--ink-soft); cursor:pointer;
  }
  .modal-wrap{position:relative;}
  .toast{
    position:fixed; bottom:90px; left:50%; transform:translateX(-50%);
    background:var(--ink); color:#fff; padding:9px 16px; border-radius:999px;
    font-size:.85rem; z-index:60; opacity:0; pointer-events:none; transition:.25s;
  }
  .toast.show{opacity:1;}

  #printArea{display:none;}
  @media print{
    body *{visibility:hidden;}
    #printArea, #printArea *{visibility:visible;}
    #printArea{
      display:block; position:absolute; top:0; left:0; width:100%;
      padding:20px; color:#000;
    }
    #printArea h2{margin-bottom:4px;}
    #printArea h4{margin:14px 0 4px; border-bottom:1px solid #999; padding-bottom:2px;}
  }
</style>
</head>
